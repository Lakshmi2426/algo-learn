# Frontend Web Service Port (defaults to 3000 locally, provided dynamically by Render in production)
PORT=3000

# Backend API Service URL used by Express proxy (forwards /api/auth, /api/students, /api/leaderboard)
# Production Deployed Render Backend:
BACKEND_URL=https://algolearn-1yp9.onrender.com

# Local Development Backend (uncomment for local development if running backend on port 5000):
# BACKEND_URL=http://127.0.0.1:5000

# Google Gemini API Key (Optional: for AI Assistant / Chat features)
GEMINI_API_KEY=

